// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Plataforma / Tenants ----------

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

// Para separar, en las estadísticas de /platform, lo que es negocio real de
// lo que no: DEMO son las copias de scripts/seed-demo-pizzeria.ts (ver
// DEMO_SUBDOMAINS) y PROMOCION una tienda de prueba/cortesía sin intención
// de pagar. Ninguna de las dos cuenta en getPlatformStats.
enum TenantCategory {
  CLIENTE
  DEMO
  PROMOCION
}

enum OrderingMode {
  WEEKLY_HOURS
  SCHEDULED_SALES
}

// Estado de facturación manejado a mano por el super admin — no hay pasarela
// de pago integrada, esto es solo un registro de "quién pagó y cuándo vence".
enum BillingStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

// Los planes los define el propio super admin desde /platform/planes — acá
// no hardcodeamos nombres ni precios reales, son datos de negocio.
model Plan {
  id                String   @id @default(cuid())
  name              String   @unique
  priceMonthly      Decimal
  priceAnnual       Decimal?
  trialDays         Int      @default(10)
  // Límites opcionales — null significa "sin límite" en esa dimensión.
  maxProducts       Int?
  maxOrdersPerMonth Int?
  // Habilita la sección de dominio propio en Configuración para las tiendas
  // en este plan — se puede prender/apagar en cualquier momento sin tocar
  // código, desde /platform/planes.
  allowCustomDomain Boolean  @default(false)
  // Funciones que ya tenían todos los planes existentes antes de este
  // toggle — por eso arrancan en `true` (a diferencia de allowCustomDomain,
  // que es un upsell y arranca en false) y el super admin las apaga por
  // plan solo si quiere restringirlas.
  allowServices     Boolean  @default(true)
  allowLoyalty      Boolean  @default(true)
  allowStats        Boolean  @default(true)
  allowTelegram     Boolean  @default(true)
  description       String?
  active            Boolean  @default(true)
  // Solo un plan a la vez lleva el badge "Más elegido" en la landing
  // pública — setFeaturedPlan() en /platform/planes se encarga de que
  // marcar uno desmarque a los demás.
  featured          Boolean  @default(false)
  order             Int      @default(0)
  createdAt         DateTime @default(now())

  tenants            Tenant[]
  planChangeRequests Tenant[] @relation("PlanChangeRequest")
  pendingSignups     User[]   @relation("PendingSignupPlan")
}

// Cada fila es un cobro que el super admin registró a mano (no un webhook de
// pasarela) — sirve como historial de "quién pagó qué mes".
model BillingPayment {
  id                     String   @id @default(cuid())
  tenantId               String
  amount                 Decimal
  periodStart            DateTime
  periodEnd              DateTime
  paidAt                 DateTime @default(now())
  note                   String?
  provider               String?
  providerPaymentId      String?  @unique
  providerSubscriptionId String?
  createdAt              DateTime @default(now())

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  resellerCommission ResellerCommission?

  @@index([tenantId])
}

// Configuración comercial global. Las credenciales no se guardan acá:
// viven como secretos del servidor. Esto permite editar la política de
// cobro desde Platform sin exponer llaves capaces de mover dinero.
model PlatformBillingSettings {
  id                       String   @id @default("global")
  enabled                  Boolean  @default(false)
  currency                 String   @default("ARS")
  graceDays                Int      @default(5)
  accessTokenEnc           String?
  webhookSecretEnc         String?
  marketingWhatsappEnabled Boolean  @default(false)
  marketingWhatsappNumber  String?
  marketingWhatsappMessage String?
  updatedAt                DateTime @updatedAt
}

model BillingWebhookEvent {
  id          String    @id @default(cuid())
  eventKey    String    @unique
  topic       String
  resourceId  String
  status      String
  error       String?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
}

// ---------- Programa de revendedores ----------

// Fila única (id fijo) con las condiciones del bono por activación. Editable
// desde /platform — y estos mismos valores son los que se muestran en la
// página pública de /revendedores, para que nunca queden desincronizados.
model ResellerSettings {
  id                    String   @id @default("global")
  activationBonusAmount Decimal  @default(0)
  activationBonusDays   Int      @default(60)
  // Días desde que se genera una comisión (recurrente o bono) hasta que hay
  // que pagarla. Es el mismo plazo para todos los tipos — el reloj arranca
  // cuando la fila de ResellerCommission se crea, no antes.
  commissionPayoutDays  Int      @default(30)
  updatedAt             DateTime @updatedAt
}

// Escalones de comisión: "desde tantas tiendas activas, tal porcentaje".
// Se editan libremente desde /platform — cuantos se quiera.
model ResellerCommissionTier {
  id              String   @id @default(cuid())
  minActiveStores Int      @unique
  percent         Decimal
  createdAt       DateTime @default(now())
}

enum ResellerCommissionType {
  RECURRING
  ACTIVATION_BONUS
}

enum ResellerCommissionStatus {
  PENDING
  PAID
}

// Una fila por cada comisión que un revendedor ganó — recurrente (atada a
// un cobro real de BillingPayment) o el bono de activación (uno por
// tienda, una sola vez). El super admin las marca pagadas a mano cuando de
// verdad transfiere la plata, igual que ya hace con los cobros de tiendas.
model ResellerCommission {
  id             String                   @id @default(cuid())
  resellerId     String
  tenantId       String
  type           ResellerCommissionType
  amount         Decimal
  // Null en el bono de activación — ahí no aplica un % sobre nada.
  percentApplied Decimal?
  status         ResellerCommissionStatus @default(PENDING)
  createdAt      DateTime                 @default(now())
  paidAt         DateTime?

  // Solo en RECURRING — el cobro puntual que generó esta comisión.
  billingPaymentId String?         @unique
  billingPayment   BillingPayment? @relation(fields: [billingPaymentId], references: [id])

  reseller User   @relation("ResellerCommissions", fields: [resellerId], references: [id])
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([resellerId])
  @@index([tenantId])
}

// Códigos creados por la plataforma para bonificar el alta de una tienda.
// El beneficio se consume recién cuando el Tenant se crea, no al escribir
// el código, para que los registros abandonados no gasten usos.
model PromotionCode {
  id             String    @id @default(cuid())
  code           String    @unique
  description    String?
  durationMonths Int       @default(12)
  maxUses        Int?
  usedCount      Int       @default(0)
  active         Boolean   @default(true)
  validUntil     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  pendingUsers User[]                @relation("PendingPromotion")
  redemptions  PromotionRedemption[]
}

model PromotionRedemption {
  id              String   @id @default(cuid())
  promotionCodeId String
  tenantId        String   @unique
  startsAt        DateTime
  endsAt          DateTime
  createdAt       DateTime @default(now())

  promotionCode PromotionCode @relation(fields: [promotionCodeId], references: [id])
  tenant        Tenant        @relation(fields: [tenantId], references: [id])

  @@index([promotionCodeId])
}

model Tenant {
  id                   String         @id @default(cuid())
  subdomain            String         @unique
  status               TenantStatus   @default(ACTIVE)
  // Manual, tildado desde /platform/tiendas/[tenantId] — no se infiere solo.
  category             TenantCategory @default(CLIENTE)
  orderingMode         OrderingMode   @default(SCHEDULED_SALES)
  ordersManuallyClosed Boolean        @default(false)
  // Apagado general de la tienda desde el admin — independiente del modo y
  // de los horarios/fechas configurados. Mientras esté en false, el
  // storefront muestra "Tienda cerrada" y no se puede hacer ningún pedido.
  storeOpen            Boolean        @default(true)
  createdAt            DateTime       @default(now())

  // Datos que se cargan una vez en el alta (/registro/datos) — para vos
  // como plataforma, no para mostrarle al público. Ciudad y provincia sí
  // son de cara al público y por eso van como Settings (store_city,
  // store_province), igual que la dirección, editables después desde
  // /admin/configuracion.
  businessCategory String?
  referralSource   String?

  planId String?
  plan   Plan?   @relation(fields: [planId], references: [id])

  // Pedido del dueño de la tienda para cambiar de plan — se pide desde
  // /admin/configuracion, lo ve y aplica el super admin a mano desde
  // /platform (sigue sin pasarela de pago real, esto NO cambia el plan
  // solo). null cuando no hay ningún pedido pendiente.
  requestedPlanId            String?
  requestedPlan              Plan?                @relation("PlanChangeRequest", fields: [requestedPlanId], references: [id])
  requestedPlanAt            DateTime?
  billingStatus              BillingStatus        @default(TRIAL)
  trialEndsAt                DateTime?
  nextBillingDate            DateTime?
  billingNotes               String?
  billingCycle               BillingCycle?
  providerSubscriptionId     String?              @unique
  providerSubscriptionStatus String?
  subscriptionStartedAt      DateTime?
  subscriptionSyncedAt       DateTime?
  billingPayments            BillingPayment[]
  promotionRedemption        PromotionRedemption?

  // Dominio propio (ej: pedidos.mimarca.com) — solo disponible si el plan de
  // la tienda tiene allowCustomDomain. El token se le pide al dueño del
  // dominio como registro TXT para probar que es suyo antes de servir la
  // tienda ahí; una vez verificado, customDomain empieza a resolver tenant
  // igual que el subdominio.
  customDomain         String? @unique
  customDomainToken    String?
  customDomainVerified Boolean @default(false)

  users User[] @relation("TenantUsers")

  // Revendedor que trajo esta tienda (si vino de un código) — solo para
  // calcular a quién corresponde la comisión de sus cobros. No cambia nada
  // de cara al dueño de la tienda.
  referredByResellerId String?
  referredByReseller   User?                     @relation("TenantReferredBy", fields: [referredByResellerId], references: [id])
  resellerCommissions  ResellerCommission[]
  categories           ProductCategory[]
  products             Product[]
  stockGroups          StockGroup[]
  services             Service[]
  serviceInquiries     ServiceInquiry[]
  deliveryDates        DeliveryDate[]
  storeClosures        StoreClosure[]
  weeklyScheduleRules  WeeklyScheduleRule[]
  paymentMethods       PaymentMethodConfig[]
  fulfillmentMethods   FulfillmentMethodConfig[]
  pickupSlots          PickupSlot[]
  orders               Order[]
  pointsRules          PointsRule[]
  coupons              Coupon[]
  settings             Settings[]
  aboutMedia           AboutMedia[]
  stockMovements       StockMovement[]
  emailLogs            EmailLog[]
  whatsappLogs         WhatsappLog[]
  domainRequests       DomainRequest[]
}

enum DomainRequestStatus {
  PENDING
  IN_PROGRESS
  DONE
}

// Cuando el dueño de una tienda no quiere ocuparse él mismo del trámite del
// dominio propio (comprarlo, darlo de alta, cargar los registros DNS) pide
// que YAA lo haga por él — ver el botón "Lo hacemos por vos" en Dominio
// propio. Sin automatización de compra: el super admin la gestiona a mano
// desde /platform/dominios.
model DomainRequest {
  id            String              @id @default(cuid())
  tenantId      String
  contactName   String
  contactEmail  String
  contactPhone  String?
  domainOptions String[]
  notes         String?
  status        DomainRequestStatus @default(PENDING)
  createdAt     DateTime            @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

// Cada entrada a /demo (ver src/app/demo/) queda registrada acá para medir
// interés real en el producto: quién probó, con qué copia y cuándo. No se
// ata a un Tenant — las tiendas demo son compartidas (ver DEMO_SUBDOMAINS)
// y se reciclan entre visitantes distintos.
model DemoVisit {
  id        String   @id @default(cuid())
  email     String
  subdomain String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---------- Auth ----------

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
  // Socio comercial: trae tiendas nuevas con su código y cobra comisión.
  // Vive en el mismo espacio tenantId null que el super admin y quien se
  // está registrando todavía sin tienda (ver getUserByEmail en
  // lib/auth-adapter.ts, que ya filtra por role ahí).
  RESELLER
}

model User {
  id            String    @id @default(cuid())
  tenantId      String?
  name          String?
  email         String
  emailVerified DateTime?
  image         String?
  phone         String?
  address       String?
  passwordHash  String?
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Mientras un usuario se está registrando en yaa.com.ar y todavía no tiene
  // tienda (tenantId null): plan elegido y marca de "ya pagó" el onboarding.
  // Se limpian cuando /registro/datos crea el Tenant y lo pasa a ADMIN.
  pendingPlanId             String?
  pendingPlan               Plan?          @relation("PendingSignupPlan", fields: [pendingPlanId], references: [id])
  onboardingPaidAt          DateTime?
  pendingBillingCycle       BillingCycle?
  pendingSubscriptionId     String?        @unique
  pendingSubscriptionStatus String?
  pendingPromotionCodeId    String?
  pendingPromotionCode      PromotionCode? @relation("PendingPromotion", fields: [pendingPromotionCodeId], references: [id])

  // Código propio de un revendedor para repartir — se genera al elegir "ser
  // socio" en /registro, único, se usa en la URL del QR
  // (/registro?ref=CODIGO). Ser revendedor es tener este código, NO un rol
  // aparte: un CUSTOMER sin tienda todavía o un ADMIN de su propia tienda
  // pueden tenerlo por igual (ver lib/require-reseller.ts).
  referralCode String? @unique

  // Se marca acá en vez de borrar referralCode al desactivar — así el
  // historial de comisiones sigue apareciendo en /platform/revendedores en
  // vez de desaparecer, y el código no queda libre para que otra persona
  // lo reclame.
  resellerDeactivatedAt DateTime?

  // Código de un revendedor que alguien trae consigo mientras todavía se
  // está registrando (llegó por /registro?ref=CODIGO, o lo tipeó a mano) —
  // se consume recién al crear la tienda, ahí pasa a Tenant.referredByResellerId.
  pendingReferralCode String?

  tenant Tenant? @relation("TenantUsers", fields: [tenantId], references: [id])

  // Tiendas que este revendedor trajo (role RESELLER) — no confundir con
  // `tenant` de arriba, que es la tienda PROPIA de un admin/cliente.
  referredTenants     Tenant[]             @relation("TenantReferredBy")
  resellerCommissions ResellerCommission[] @relation("ResellerCommissions")

  accounts         Account[]
  sessions         Session[]
  orders           Order[]
  pointsLedger     PointsLedger[]
  couponRedemption CouponRedemption[]
  whatsappLogs     WhatsappLog[]

  @@unique([tenantId, email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  // Copiado del User al vincular la cuenta — permite que la misma cuenta de
  // Google se vincule a un usuario distinto por cada tienda (tenant), en vez
  // de compartir un solo User global entre tiendas distintas.
  tenantId          String?
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Una fila por intento fallido de una acción sensible (login, registro,
// recuperar contraseña). Se cuentan los de una misma `key` dentro de una
// ventana de tiempo para frenar fuerza bruta. Va en la base y no en memoria
// a propósito: sobrevive reinicios y sirve aunque corran varios procesos
// de Next detrás de Nginx. Ver lib/rate-limit.ts.
model RateLimitAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// ---------- Catálogo ----------

model ProductCategory {
  id       String    @id @default(cuid())
  tenantId String
  name     String
  icon     String?
  active   Boolean   @default(true)
  products Product[]

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
}

model Product {
  id           String   @id @default(cuid())
  tenantId     String
  categoryId   String
  name         String
  description  String?
  active       Boolean  @default(true)
  featured     Boolean  @default(false)
  // Pausa rápida sin fecha ni cantidad, solo tiene efecto en modo
  // WEEKLY_HOURS (delivery del día) — en SCHEDULED_SALES manda el stock
  // por fecha en su lugar.
  soldOutToday Boolean  @default(false)
  // Para productos "a pedido" (catering, encargos grandes, etc.) donde el
  // precio varía por consulta — oculta el precio y el carrito, y en su
  // lugar muestra un botón de WhatsApp. Las variantes siguen existiendo
  // para no romper el modelo, pero su precio no se le muestra al cliente.
  contactToBuy Boolean  @default(false)
  tags         String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  category ProductCategory  @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]
  images   ProductImage[]

  @@index([tenantId])
}

// Pozo de stock: puede tener un solo miembro (stock individual de esa
// variante) o varios (compartido entre variantes de un mismo producto, o
// incluso de productos distintos — ej: "Pizzas grandes" repartido entre
// todos los gustos que vienen en tamaño grande).
model StockGroup {
  id                   String  @id @default(cuid())
  tenantId             String
  name                 String
  defaultStockQuantity Int?
  // true cuando lo creó el sistema solo, al vuelo, para el pozo propio de
  // una variante ("__solo__"/"__siblings__" en resolveVariantStockGroupId)
  // — no algo que el dueño de la tienda armó a mano en "Grupos de stock".
  // Sirve para ocultarlos del selector "Compartir con...": antes ese
  // selector filtraba por cantidad de miembros (2+), pero eso hacía que un
  // grupo recién creado a mano, todavía con 0 miembros, tampoco apareciera
  // — imposible de elegir la primera vez.
  isIndividual         Boolean @default(false)

  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  variants       ProductVariant[]
  stock          StockGroupStock[]
  stockMovements StockMovement[]

  @@unique([tenantId, name])
}

model ProductVariant {
  id           String  @id @default(cuid())
  productId    String
  stockGroupId String
  gusto        String?
  tamano       String?
  sku          String?
  price        Decimal @db.Decimal(10, 2)
  active       Boolean @default(true)
  order        Int     @default(0)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockGroup StockGroup  @relation(fields: [stockGroupId], references: [id])
  orderItems OrderItem[]

  @@index([stockGroupId])
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  url       String
  order     Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ---------- Servicios cotizados por presupuesto ----------

enum ServiceFieldType {
  TEXT
  TEXTAREA
  EMAIL
  PHONE
  NUMBER
  DATE
  SELECT
}

model Service {
  id                 String   @id @default(cuid())
  tenantId           String
  title              String
  description        String
  descriptionColumns Boolean  @default(false)
  formTitle          String
  submitLabel        String   @default("Enviar consulta")
  active             Boolean  @default(true)
  order              Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  fields    ServiceField[]
  images    ServiceImage[]
  inquiries ServiceInquiry[]

  @@index([tenantId])
}

model ServiceField {
  id        String           @id @default(cuid())
  serviceId String
  label     String
  type      ServiceFieldType @default(TEXT)
  required  Boolean          @default(false)
  options   String[]         @default([])
  order     Int              @default(0)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, order])
}

model ServiceImage {
  id        String @id @default(cuid())
  serviceId String
  url       String
  order     Int    @default(0)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, order])
}

enum ServiceInquiryStatus {
  NEW
  IN_PROGRESS
  QUOTED
  RESPONDED
  ACCEPTED
  REJECTED
  CLOSED
}

model ServiceInquiry {
  id                String               @id @default(cuid())
  tenantId          String
  serviceId         String?
  serviceTitle      String
  answers           Json
  status            ServiceInquiryStatus @default(NEW)
  quotedAmount      Decimal?             @db.Decimal(12, 2)
  internalNotes     String?
  telegramSent      Boolean              @default(false)
  emailSent         Boolean              @default(false)
  notificationError String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  tenant  Tenant                @relation(fields: [tenantId], references: [id])
  service Service?              @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  events  ServiceInquiryEvent[]

  @@index([tenantId, status, createdAt])
  @@index([serviceId])
}

model ServiceInquiryEvent {
  id           String               @id @default(cuid())
  inquiryId    String
  status       ServiceInquiryStatus
  quotedAmount Decimal?             @db.Decimal(12, 2)
  notes        String?
  createdAt    DateTime             @default(now())

  inquiry ServiceInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId, createdAt])
}

// ---------- Fechas de entrega y stock ----------

enum DeliveryDateStatus {
  OPEN
  CLOSED
  EXPIRED
}

// Cómo se maneja el stock para una fecha puntual: BY_GROUP usa los pozos
// de cada variante (StockGroupStock — individuales o compartidos, según
// cómo esté armado el catálogo); UNLIMITED no trackea nada, todo
// disponible siempre.
enum DateStockMode {
  BY_GROUP
  UNLIMITED
}

enum StockMovementReason {
  SALE // un pedido consumió stock
  RESTOCK // un pedido se canceló/borró y liberó lo que había consumido
  ADJUSTMENT // el admin cambió el tope disponible a mano
}

model DeliveryDate {
  id                    String             @id @default(cuid())
  tenantId              String
  date                  DateTime
  orderOpenAt           DateTime?
  cutoffAt              DateTime?
  capacity              Int?
  status                DeliveryDateStatus @default(OPEN)
  stockMode             DateStockMode      @default(BY_GROUP)
  notes                 String?
  createdAt             DateTime           @default(now())
  // Antes de que abra el pedido (orderOpenAt en el futuro), el storefront
  // por default oculta todo y solo avisa cuándo abrimos. Con esto en true
  // deja ver el catálogo igual — sin poder agregar al carrito, cada
  // producto muestra la fecha de apertura en vez del botón "Agregar".
  showCatalogBeforeOpen Boolean            @default(false)

  tenant          Tenant             @relation(fields: [tenantId], references: [id])
  stockGroupStock StockGroupStock[]
  orders          Order[]
  pickupSlots     PickupSlot[]
  stockMovements  StockMovement[]
  costs           DeliveryDateCost[]

  @@index([tenantId])
}

// Costos sueltos cargados a mano para una fecha puntual (ej: ingredientes,
// delivery, alquiler del local ese día) — opcional, se van agregando de a
// uno. Sirve para sacar el resultado neto (ventas - costos) en Estadísticas.
model DeliveryDateCost {
  id             String   @id @default(cuid())
  deliveryDateId String
  label          String
  amount         Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now())

  deliveryDate DeliveryDate @relation(fields: [deliveryDateId], references: [id], onDelete: Cascade)

  @@index([deliveryDateId])
}

// Modo "horario semanal": un día de la semana habilitado, con 1 o 2 franjas
// (WeeklyScheduleWindow) de pedido + entrega/retiro (ej: mediodía y noche).
model WeeklyScheduleRule {
  id       String  @id @default(cuid())
  tenantId String
  weekday  Int
  enabled  Boolean @default(true)

  tenant  Tenant                 @relation(fields: [tenantId], references: [id])
  windows WeeklyScheduleWindow[]

  @@unique([tenantId, weekday])
}

model WeeklyScheduleWindow {
  id               String @id @default(cuid())
  ruleId           String
  order            Int    @default(0)
  orderOpenTime    String
  orderCloseTime   String
  fulfillmentStart String
  fulfillmentEnd   String

  rule WeeklyScheduleRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
}

// ---------- Entrega (delivery / retiro) ----------

enum FulfillmentType {
  DELIVERY
  PICKUP
}

model FulfillmentMethodConfig {
  id       String          @id @default(cuid())
  tenantId String
  type     FulfillmentType
  enabled  Boolean         @default(false)
  config   Json?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, type])
}

model PickupSlot {
  id             String  @id @default(cuid())
  tenantId       String
  deliveryDateId String?
  label          String
  order          Int     @default(0)

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  deliveryDate DeliveryDate? @relation(fields: [deliveryDateId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@index([tenantId])
  @@index([deliveryDateId])
}

model StockGroupStock {
  id                String @id @default(cuid())
  stockGroupId      String
  deliveryDateId    String
  quantityAvailable Int? // null = sin límite
  quantitySold      Int    @default(0)

  stockGroup   StockGroup   @relation(fields: [stockGroupId], references: [id], onDelete: Cascade)
  deliveryDate DeliveryDate @relation(fields: [deliveryDateId], references: [id], onDelete: Cascade)

  @@unique([stockGroupId, deliveryDateId])
}

// Historial de cada cambio al stock de una fecha: ventas (al confirmar un
// pedido), reposiciones (al cancelar/borrar uno) y ajustes manuales del
// admin. "delta" es el cambio en el remanente (negativo = bajó, positivo =
// subió); quantityAvailable/quantitySold son la foto resultante.
model StockMovement {
  id                String              @id @default(cuid())
  tenantId          String
  deliveryDateId    String
  stockGroupId      String?
  reason            StockMovementReason
  delta             Int?
  quantityAvailable Int?
  quantitySold      Int
  note              String?
  createdAt         DateTime            @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveryDate DeliveryDate @relation(fields: [deliveryDateId], references: [id], onDelete: Cascade)
  stockGroup   StockGroup?  @relation(fields: [stockGroupId], references: [id], onDelete: Cascade)

  @@index([tenantId, deliveryDateId])
}

model StoreClosure {
  id        String   @id @default(cuid())
  tenantId  String
  startDate DateTime
  endDate   DateTime
  reason    String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

// ---------- Medios de pago ----------

enum PaymentMethodType {
  CASH_ON_DELIVERY
  TRANSFER
  MERCADOPAGO
}

model PaymentMethodConfig {
  id                String            @id @default(cuid())
  tenantId          String
  type              PaymentMethodType
  enabled           Boolean           @default(false)
  // Nombre a mostrar en vez del default (ej: "Efectivo" -> "Pago al retirar").
  label             String?
  // Solo aplica a CASH_ON_DELIVERY: si está seteado, ese medio de pago
  // se oculta para quien no tenga al menos esta cantidad de pedidos
  // previos (los invitados, sin cuenta, nunca lo cumplen).
  minPreviousOrders Int?
  config            Json?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, type])
}

// ---------- Pedidos ----------

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_REVIEW
  CONFIRMED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

model Order {
  id                 String            @id @default(cuid())
  tenantId           String
  // null = pedido de invitado (sin cuenta) — en ese caso guestName/guestEmail
  // tienen los datos que cargó a mano en el checkout.
  userId             String?
  guestName          String?
  guestEmail         String?
  deliveryDateId     String
  fulfillmentType    FulfillmentType
  pickupSlotId       String?
  deliveryAddress    String?
  deliveryPhone      String
  status             OrderStatus       @default(PENDING_PAYMENT)
  paymentMethod      PaymentMethodType
  subtotal           Decimal           @db.Decimal(10, 2)
  deliveryFee        Decimal           @default(0) @db.Decimal(10, 2)
  discountFromCoupon Decimal           @default(0) @db.Decimal(10, 2)
  total              Decimal           @db.Decimal(10, 2)
  pointsEarned       Int               @default(0)
  couponId           String?
  mpPreferenceId     String?
  mpPaymentId        String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  user         User?          @relation(fields: [userId], references: [id])
  deliveryDate DeliveryDate   @relation(fields: [deliveryDateId], references: [id])
  pickupSlot   PickupSlot?    @relation(fields: [pickupSlotId], references: [id], onDelete: SetNull)
  coupon       Coupon?        @relation(fields: [couponId], references: [id])
  items        OrderItem[]
  paymentProof PaymentProof?
  pointsLedger PointsLedger[]

  @@index([tenantId])
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  productVariantId String
  quantity         Int
  unitPrice        Decimal @db.Decimal(10, 2)

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
}

enum PaymentProofStatus {
  PENDING
  APPROVED
  REJECTED
}

model PaymentProof {
  id         String             @id @default(cuid())
  orderId    String             @unique
  url        String
  uploadedAt DateTime           @default(now())
  status     PaymentProofStatus @default(PENDING)
  reviewedAt DateTime?
  reviewedBy String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ---------- Puntos y cupones ----------

model PointsRule {
  id              String    @id @default(cuid())
  tenantId        String
  pointsPerAmount Decimal   @db.Decimal(10, 4)
  effectiveFrom   DateTime  @default(now())
  effectiveTo     DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model PointsLedger {
  id        String   @id @default(cuid())
  userId    String
  orderId   String?
  couponId  String?
  delta     Int
  reason    String
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id])
  order  Order?  @relation(fields: [orderId], references: [id])
  coupon Coupon? @relation(fields: [couponId], references: [id])
}

enum CouponDiscountType {
  PERCENT
  FIXED
}

model Coupon {
  id            String             @id @default(cuid())
  tenantId      String
  code          String
  pointsCost    Int                @default(0)
  discountType  CouponDiscountType
  discountValue Decimal            @db.Decimal(10, 2)
  active        Boolean            @default(true)
  usageLimit    Int?
  expiresAt     DateTime?
  createdAt     DateTime           @default(now())

  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  orders       Order[]
  pointsLedger PointsLedger[]
  redemptions  CouponRedemption[]

  @@unique([tenantId, code])
}

model CouponRedemption {
  id         String   @id @default(cuid())
  userId     String?
  couponId   String
  orderId    String?
  redeemedAt DateTime @default(now())

  user   User?  @relation(fields: [userId], references: [id])
  coupon Coupon @relation(fields: [couponId], references: [id])
}

// ---------- Config general ----------

model Settings {
  tenantId String
  key      String
  value    String

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, key])
}

// Historial de cada mail que la app intentó mandar (confirmación de
// pedido, recuperación de contraseña, pruebas desde el admin) — para poder
// ver desde el panel si efectivamente salieron, sin depender del proveedor
// SMTP externo.
model EmailLog {
  id        String   @id @default(cuid())
  tenantId  String
  to        String
  subject   String
  type      String
  success   Boolean
  error     String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
}

// Queda registrado cada vez que un admin le manda un WhatsApp a un cliente
// desde una campaña — no hay forma de confirmar que WhatsApp lo entregó (el
// envío pasa por WhatsApp Web, fuera de la app), esto solo marca que el
// admin abrió el link con el mensaje.
model WhatsappLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  phone     String
  message   String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
}

// ---------- Sobre nosotros ----------

enum AboutMediaType {
  IMAGE
  VIDEO
}

model AboutMedia {
  id        String         @id @default(cuid())
  tenantId  String
  type      AboutMediaType
  url       String
  order     Int            @default(0)
  createdAt DateTime       @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}
